[32m+[m[32m    private void renderizarHeatmapCorrelacion(double[][] matrix, List<String> assets) {[m
[32m+[m[32m        gridCorrelation.removeAllViews();[m
[32m+[m[32m        int n = assets.size();[m
[32m+[m
[32m+[m[32m        // Dimensiones: N+1 porque la primera fila y columna son las etiquetas (Tickers)[m
[32m+[m[32m        gridCorrelation.setRowCount(n + 1);[m
[32m+[m[32m        gridCorrelation.setColumnCount(n + 1);[m
[32m+[m
[32m+[m[32m        // Esquina superior izquierda (vacía)[m
[32m+[m[32m        gridCorrelation.addView(crearCeldaHeatmap("", Color.TRANSPARENT, true));[m
[32m+[m
[32m+[m[32m        // Cabeceras de columnas (Tickers en el eje X)[m
[32m+[m[32m        for (String asset : assets) {[m
[32m+[m[32m            gridCorrelation.addView(crearCeldaHeatmap(asset, Color.parseColor("#333333"), true));[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        // Bucle para pintar filas y datos[m
[32m+[m[32m        for (int i = 0; i < n; i++) {[m
[32m+[m[32m            // Cabecera de fila (Ticker en el eje Y)[m
[32m+[m[32m            gridCorrelation.addView(crearCeldaHeatmap(assets.get(i), Color.parseColor("#333333"), true));[m
[32m+[m
[32m+[m[32m            // Valores de la matriz rho_ij[m
[32m+[m[32m            for (int j = 0; j < n; j++) {[m
[32m+[m[32m                double val = matrix[i][j];[m
[32m+[m[32m                int bgColor = calcularColorCorrelacion(val);[m
[32m+[m[32m                String text = String.format(Locale.US, "%.2f", val);[m
[32m+[m
[32m+[m[32m                // Si es la diagonal principal (rho = 1), podemos ponerle un marcador visual o dejarlo normal[m
[32m+[m[32m                gridCorrelation.addView(crearCeldaHeatmap(text, bgColor, false));[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    private int calcularColorCorrelacion(double rho) {[m
[32m+[m[32m        // Interpola el color basado en la intensidad de rho en [-1, 1][m
[32m+[m[32m        int alpha = 255;[m
[32m+[m[32m        int r = 0, g = 0, b = 0;[m
[32m+[m
[32m+[m[32m        if (rho > 0) {[m
[32m+[m[32m            // Correlación positiva: de Negro (0) a Verde (255)[m
[32m+[m[32m            g = (int) (rho * 200); // 200 en lugar de 255 para que no sea un verde cegador[m
[32m+[m[32m        } else if (rho < 0) {[m
[32m+[m[32m            // Correlación negativa: de Negro (0) a Rojo (255)[m
[32m+[m[32m            r = (int) (Math.abs(rho) * 200);[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        return Color.argb(alpha, r, g, b);[m
[32m+[m[32m    }[m

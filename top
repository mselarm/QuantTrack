[32m+[m[32m    private void evaluarRiesgo() {[m
[32m+[m[32m        if (portfolio.size() < 2) {[m
[32m+[m[32m            Toast.makeText(getContext(), "Necesitas al menos 2 activos para la matriz de covarianza", Toast.LENGTH_LONG).show();[m
[32m+[m[32m            return;[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        tvRiskMetrics.setText("Descargando tensores financieros...");[m
[32m+[m[32m        tvRiskMetrics.setTextColor(Color.YELLOW);[m
[32m+[m
[32m+[m[32m        // Mapa concurrente porque recibiremos callbacks desde distintos hilos de red[m
[32m+[m[32m        Map<String, Map<String, DailyData>> allMarketData = new ConcurrentHashMap<>();[m
[32m+[m[32m        int expectedCallbacks = portfolio.size();[m
[32m+[m[32m        AtomicInteger completedCallbacks = new AtomicInteger(0);[m
[32m+[m
[32m+[m[32m        for (String ticker : portfolio.keySet()) {[m
[32m+[m[32m            repository.fetchDailyData(ticker, new MarketRepository.DataCallback() {[m
[32m+[m[32m                @Override[m
[32m+[m[32m                public void onSuccess(Map<String, DailyData> data) {[m
[32m+[m[32m                    allMarketData.put(ticker, data);[m
[32m+[m[32m                    checkBarrier(completedCallbacks.incrementAndGet(), expectedCallbacks, allMarketData);[m
[32m+[m[32m                }[m
[32m+[m
[32m+[m[32m                @Override[m
[32m+[m[32m                public void onError(String error) {[m
[32m+[m[32m                    // 1. Eliminamos de RAM[m
[32m+[m[32m                    portfolio.remove(ticker);[m
[32m+[m
[32m+[m[32m                    // 2. Eliminamos de Disco (por si el ticker dejó de cotizar)[m
[32m+[m[32m                    diskExecutor.execute(() -> db.portfolioDao().deleteAsset(ticker));[m
[32m+[m
[32m+[m[32m                    completedCallbacks.incrementAndGet();[m
[32m+[m[32m                    if (getActivity() != null) {[m
[32m+[m[32m                        getActivity().runOnUiThread(() -> {[m
[32m+[m[32m                            Toast.makeText(getContext(), "Ticker descartado: " + ticker + " (" + error + ")", Toast.LENGTH_LONG).show();[m
[32m+[m[32m                            // 2. Actualizamos la interfaz para que el usuario vea que ha desaparecido[m
[32m+[m[32m                            actualizarEstadoUI();[m
[32m+[m[32m                        });[m
[32m+[m[32m                    }[m
[32m+[m[32m                    checkBarrier(completedCallbacks.get(), expectedCallbacks, allMarketData);[m
[32m+[m[32m                }[m
[32m+[m[32m            });[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etRiskTicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:hint="TICKER"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textAllCaps="true"
            android:maxLines="1"
            android:inputType="textCapCharacters" />

        <EditText
            android:id="@+id/etRiskShares"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="CANT."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnAddAsset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnClearPortfolio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLR"
            android:backgroundTint="#8B0000"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/btnCalculateRisk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALC"
            android:backgroundTint="#0066CC"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPortfolioHoldings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:text="Cartera vacía. Añade activos para inicializar la matriz de covarianza."
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111111"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvTotalValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="NOTIONAL: $0.00" />

        <TextView
            android:id="@+id/tvRiskMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFaa00"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="4dp"
            android:text="Volatilidad Anual: --% | VaR Diario (95%): $--" />

        <TextView
            android:id="@+id/tvExpectedShortfall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF4444"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="2dp"
            android:text="CVaR (Expected Shortfall): $--" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MATRIZ DE CORRELACIÓN (ρ)"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/gridCorrelation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alignmentMode="alignBounds" />

        </HorizontalScrollView>
    </ScrollView>

    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/portfolioPieChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
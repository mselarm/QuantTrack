[32m+[m[32m    private void checkBarrier(int completed, int expected, Map<String, Map<String, DailyData>> allMarketData) {[m
[32m+[m[32m        if (completed == expected) {[m
[32m+[m[32m            if (getActivity() != null) {[m
[32m+[m[32m                getActivity().runOnUiThread(() -> procesarAlgebraLineal(allMarketData));[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m

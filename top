[32m+[m[32m    private void procesarAlgebraLineal(Map<String, Map<String, DailyData>> allMarketData) {[m
[32m+[m[32m        if (allMarketData.size() < 2) {[m
[32m+[m[32m            tvRiskMetrics.setText("Error crítico de datos. Imposible calcular covarianza.");[m
[32m+[m[32m            tvRiskMetrics.setTextColor(Color.RED);[m
[32m+[m[32m            return;[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        // 1. Intersección de Conjuntos (Alineamiento de fechas)[m
[32m+[m[32m        Set<String> commonDates = null;[m
[32m+[m[32m        for (Map<String, DailyData> dataMap : allMarketData.values()) {[m
[32m+[m[32m            if (commonDates == null) {[m
[32m+[m[32m                commonDates = new HashSet<>(dataMap.keySet());[m
[32m+[m[32m            } else {[m
[32m+[m[32m                commonDates.retainAll(dataMap.keySet());[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        if (commonDates == null || commonDates.size() < 2) {[m
[32m+[m[32m            tvRiskMetrics.setText("No hay solapamiento temporal suficiente.");[m
[32m+[m[32m            tvRiskMetrics.setTextColor(Color.RED);[m
[32m+[m[32m            return;[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        List<String> sortedDates = new ArrayList<>(commonDates);[m
[32m+[m[32m        Collections.sort(sortedDates);[m
[32m+[m
[32m+[m[32m        int nDays = sortedDates.size();[m
[32m+[m[32m        int mAssets = allMarketData.size();[m
[32m+[m[32m        List<String> assetList = new ArrayList<>(allMarketData.keySet());[m
[32m+[m
[32m+[m[32m        // 2. Cálculo de Pesos y Notional[m
[32m+[m[32m        double totalNotional = 0.0;[m
[32m+[m[32m        double[] pricesToday = new double[mAssets];[m
[32m+[m[32m        String lastDate = sortedDates.get(nDays - 1);[m
[32m+[m
[32m+[m[32m        for (int j = 0; j < mAssets; j++) {[m
[32m+[m[32m            String ticker = assetList.get(j);[m
[32m+[m[32m            double shares = portfolio.get(ticker);[m
[32m+[m[32m            double price = allMarketData.get(ticker).get(lastDate).getClose();[m
[32m+[m[32m            pricesToday[j] = price;[m
[32m+[m[32m            totalNotional += price * shares;[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        double[] weights = new double[mAssets];[m
[32m+[m[32m        for (int j = 0; j < mAssets; j++) {[m
[32m+[m[32m            String ticker = assetList.get(j);[m
[32m+[m[32m            weights[j] = (pricesToday[j] * portfolio.get(ticker)) / totalNotional;[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        // 3. Matriz de Retornos Logarítmicos[m
[32m+[m[32m        double[][] returnsMatrix = new double[nDays - 1][mAssets];[m
[32m+[m[32m        for (int j = 0; j < mAssets; j++) {[m
[32m+[m[32m            String ticker = assetList.get(j);[m
[32m+[m[32m            Map<String, DailyData> assetData = allMarketData.get(ticker);[m
[32m+[m[32m            for (int i = 1; i < nDays; i++) {[m
[32m+[m[32m                double p_t = assetData.get(sortedDates.get(i)).getClose();[m
[32m+[m[32m                double p_t_minus_1 = assetData.get(sortedDates.get(i - 1)).getClose();[m
[32m+[m[32m                returnsMatrix[i - 1][j] = Math.log(p_t / p_t_minus_1);[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        // 4. Inyección al Motor de Riesgo[m
[32m+[m[32m        RiskEngine.RiskResult result = riskEngine.calculatePortfolioRisk(returnsMatrix, weights, totalNotional);[m
[32m+[m
[32m+[m[32m        currentNotional = totalNotional;[m
[32m+[m[32m        currentVolatility = result.annualizedVolatility * 100;[m
[32m+[m[32m        currentVaR = result.var95;[m
[32m+[m[32m        currentCVaR = result.cVar95;[m
[32m+[m
[32m+[m[32m        // 5. Renderizado del HUD (Escalares)[m
[32m+[m[32m        tvTotalValue.setText(String.format(Locale.US, "NOTIONAL: $%.2f", currentNotional));[m
[32m+[m[32m        tvRiskMetrics.setText(String.format(Locale.US, "Volatilidad Anual: %.2f%% | VaR (95%%): $%.2f", currentVolatility, currentVaR));[m
[32m+[m[32m        tvRiskMetrics.setTextColor(Color.parseColor("#FFaa00"));[m
[32m+[m[32m        tvExpectedShortfall.setText(String.format(Locale.US, "CVaR (Expected Shortfall): $%.2f", currentCVaR));[m
[32m+[m
[32m+[m[32m        // 6. Actualizamos el gráfico circular (Topología 1D de pesos)[m
[32m+[m[32m        List<PieEntry> pieEntries = new ArrayList<>();[m
[32m+[m[32m        for (int j = 0; j < mAssets; j++) {[m
[32m+[m[32m            pieEntries.add(new PieEntry((float) (weights[j] * 100), assetList.get(j)));[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        PieDataSet dataSet = new PieDataSet(pieEntries, "");[m
[32m+[m
[32m+[m[32m        // Concatenamos múltiples paletas para evitar repeticiones en carteras grandes[m
[32m+[m[32m        ArrayList<Integer> coloresGrafico = new ArrayList<>();[m
[32m+[m[32m        for (int c : ColorTemplate.MATERIAL_COLORS) coloresGrafico.add(c);[m
[32m+[m[32m        for (int c : ColorTemplate.VORDIPLOM_COLORS) coloresGrafico.add(c);[m
[32m+[m[32m        for (int c : ColorTemplate.JOYFUL_COLORS) coloresGrafico.add(c);[m
[32m+[m[32m        for (int c : ColorTemplate.LIBERTY_COLORS) coloresGrafico.add(c);[m
[32m+[m[32m        for (int c : ColorTemplate.PASTEL_COLORS) coloresGrafico.add(c);[m
[32m+[m[32m        coloresGrafico.add(ColorTemplate.getHoloBlue());[m
[32m+[m
[32m+[m[32m        dataSet.setColors(coloresGrafico); // Inyectamos la super-paleta[m
[32m+[m[32m        dataSet.setValueTextColor(Color.WHITE);[m
[32m+[m[32m        dataSet.setValueTextSize(14f);[m
[32m+[m[32m        dataSet.setSliceSpace(2f);[m
[32m+[m
[32m+[m[32m        portfolioPieChart.setData(new PieData(dataSet));[m
[32m+[m[32m        portfolioPieChart.setCenterText("CAPITAL\n$" + String.format(Locale.US, "%.0f", totalNotional));[m
[32m+[m[32m        portfolioPieChart.notifyDataSetChanged();[m
[32m+[m[32m        portfolioPieChart.invalidate();[m
[32m+[m
[32m+[m[32m        // 7. Renderizado del Heatmap (Topología NxN de correlación)[m
[32m+[m[32m        renderizarHeatmapCorrelacion(result.correlationMatrix, assetList);[m
[32m+[m[32m    }[m
